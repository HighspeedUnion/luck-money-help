{
  "name": "calculator-app",
  "version": "26.3.0",
  "description": "四面板计算器 · 日历 · 多语言",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "高速连司 (HighspeedUnion)",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.highspeedunion.calculator",
    "productName": "计算器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "icon/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
